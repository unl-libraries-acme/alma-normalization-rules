rule "Second indicator 7 and subfield 2"
when
    exists "650.a.Undocumented immigration*|Illegal immigration*"
then
    changeSecondIndicator "650" to "7" if (exists "650.a.Undocumented immigration*|Noncitizens*|Children of noncitizens*|Church work with noncitizens*|Noncitizen children*|Noncitizens in literature*|Women noncitizens*")
    addSubField "650.2.local" if (exists "650.a.Undocumented immigration*|Noncitizens*|Children of noncitizens*|Church work with noncitizens*|Noncitizen children*|Noncitizens in literature*|Women noncitizens*")  
end

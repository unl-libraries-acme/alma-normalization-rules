#This rule supplements records that have the subject headings America, Gulf of or McKinley, Mount (Alaska) with local subject fields containing the subject headings Mexico, Gulf of or Denali, Mount (Alaska).
rule "Add 690.a.Mexico, Gulf of when 651.a.America, Gulf of*"
when
    (exists "651.a.America, Gulf of*") 
then
    addField "690.a.Mexico, Gulf of" if (not exists "690.a.Mexico, Gulf of*")
    addSubfield "690.5.NbU" if (exists "690.a.Mexico, Gulf of")
    addSubfield "690.9.local" if (exists "690.a.Mexico, Gulf of")
end

rule "Add 690.a.Mexico, Gulf of when 650.z.America, Gulf of*"
when
    (exists "650.z.America, Gulf of*") 
then
    addField "690.a.Mexico, Gulf of" if (not exists "690.a.Mexico, Gulf of*")
    addSubfield "690.5.NbU" if (exists "690.a.Mexico, Gulf of")
    addSubfield "690.9.local" if (exists "690.a.Mexico, Gulf of")
end

rule "Add 690.a.Denali, Mount (Alaska), Gulf of when 651.a.McKinley, Mount (Alaska)*"
when
    (exists "651.a.McKinley, Mount (Alaska)*") 
then
    addField "690.a.Denali, Mount (Alaska)" if (not exists "690.a.Denali, Mount (Alaska)*")
    addSubfield "690.5.NbU" if (exists "690.a.Denali, Mount (Alaska)")
    addSubfield "690.9.local" if (exists "690.a.Denali, Mount (Alaska)")
end

rule "Add 690.a.Denali, Mount (Alaska), Gulf of when 650.z.McKinley, Mount (Alaska)*"
when
    (exists "650.z.McKinley, Mount (Alaska)*") 
then
    addField "690.a.Denali, Mount (Alaska)" if (not exists "690.a.Denali, Mount (Alaska)*")
    addSubfield "690.5.NbU" if (exists "690.a.Denali, Mount (Alaska)")
    addSubfield "690.9.local" if (exists "690.a.Denali, Mount (Alaska)")
end

rule "Deletes duplicate subfields"
when
    (true)
then
    correctDuplicateSubfields "690" "59"
end

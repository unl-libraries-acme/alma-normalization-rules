#This rule supplements Alma community zone records containing the subject heading Sexual minorities (and variants) with the subject headings LGBTQIA2S+ people
rule "Add 690.a.LGBTQIA2S+ people when 650.a.Sexual minorities exists"
when
    (exists "650.a.Sexual minorities*")
then
    addField "690.a.LGBTQIA2S+ people" if (not exists "690.a.LGBTQIA2S+ people*")
    addSubfield "690.5.NbU" if (exists "690.a.LGBTQIA2S+ people")
    addSubfield "690.9.local" if (exists "690.a.LGBTQIA2S+ people")
    correctDuplicateSubfields "690" "59"
    correctDuplicateFields "690"
end 


#This rule supplements records that are from the Alma Community Zone and contain the subject headings Noncitizens and Illegal immigration.
rule "Add 690.a.Undocumented immigration when 650.a.Illegal immigration exists"
when
    (exists "650.a.Illegal immigration*")
then
     addField "690.a.Undocumented immigration" if (not exists "690.a.Undocumented immigration*")
     addSubfield "690.5.NbU" if (exists "690.a.Undocumented immigration")
     addSubfield "690.9.local" if (exists "690.a.Undocumented immigration")
end 


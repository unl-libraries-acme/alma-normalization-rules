#This rule supplements Alma community zone records containing the subject heading Problem children (and variants) with the subject headings Children with behavioral problems
rule "Add 690.a.Children with behavioral problems when 650.a.Problem children exists"
when
    (exists "650.a.Problem children*")
then
     addField "690.a.Children with behavioral problems" if (not exists "690.a.Children with behavioral problems*")
     addSubfield "690.5.NbU" if (exists "690.a.Children with behavioral problems")
     addSubfield "690.9.local" if (exists "690.a.Children with behavioral problems")
end 

